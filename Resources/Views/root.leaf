{
    "templates": {
        "page": {
            "type": "container",
            "orientation": "vertical",
            "content_alignment_horizontal": "center",
            "margins": {
                "top": 0,
                "bottom": 0
            },
            "background": [
                {
                    "type": "solid",
                    "color": "#375688",
                    "angle": 270
                }
            ],
            "height": {
                "type": "match_parent"
            },
            "width": {
                "type": "match_parent"                
            }
        },
        "block": {
            "type": "container",
            "orientation": "horizontal",
            "width": {
                "type": "match_parent"
            },
            "height": {
                "type": "wrap_content"
            },
            "background": [
                {
                    "type": "solid",
                    "color": "#4172bc"
                }
            ],
            "border": {
                "corner_radius": 16
            }
            
        },
        "section_block": {
            "type": "block",
            "items": [
                {
                    "type": "image",
                    "width": {
                        "type": "fixed",
                        "value": 48
                    },
                    "aspect": {
                        "ratio": 1
                    },
                    "$image_url": "cover_url",
                    "border": {
                        "corner_radius": 8
                    },
                    "margins": {
                        "top": 16,
                        "bottom": 16,
                        "left": 16
                    }
                },
                {
                    "type": "container",
                    "orientation": "vertical",
                    "alignment_vertical": "center",
                    "items": [
                        {
                            "type": "text",
                            "font_size": 24,
                            "text_alignment_horizontal": "left",
                            "text_color": "#FFFFFF",
                            "$text": "book_title",
                            "width": {
                                "type": "match_parent"
                            },
                            "margins": {
                                "top": 8,
                                "bottom": 4,
                                "left": 8,
                                "right": 16
                            }
                        }
                    ]
                }
            ]
        },
        "book_block": {
            "type": "block",
            "items": [
                {
                    "type": "image",
                    "width": {
                        "type": "fixed",
                        "value": 48
                    },
                    "aspect": {
                        "ratio": 1
                    },
                    "$image_url": "cover_url",
                    "border": {
                        "corner_radius": 8
                    },
                    "margins": {
                        "top": 16,
                        "bottom": 16,
                        "left": 16
                    }
                },
                {
                    "type": "container",
                    "orientation": "vertical",
                    "alignment_vertical": "center",
                    "items": [
                        {
                            "type": "text",
                            "font_size": 24,
                            "text_alignment_horizontal": "left",
                            "text_color": "#FFFFFF",
                            "$text": "book_title",
                            "width": {
                                "type": "match_parent"
                            },
                            "margins": {
                                "top": 8,
                                "bottom": 4,
                                "left": 8,
                                "right": 16
                            }
                        },
                        {
                            "type": "text",
                            "font_size": 12,
                            "text_alignment_horizontal": "left",
                            "text_color": "#a5c6f8",
                            "$text": "book_author",
                            "width": {
                                "type": "match_parent"
                            },
                            "margins": {
                                "bottom": 8,
                                "left": 8,
                                "right": 16
                            }
                        }
                    ]
                }
            ]
        },
        "title": {
            "type": "text",
            "text_color": "#FFFFFF",
            "font_size": 20,
            "line_height": 24,
            "font_weight": "bold"
        },
        "subtitle": {
            "type": "text",
            "text_color": "#a5c6f8",
            "font_size": 15,
            "line_height": 20,
            "paddings": {
                "left": 24,
                "right": 24
            }
        }
    },
    "card": {
        "log_id": "books_card",
        "states": [
            {
                "state_id": 0,
                "div": {
                    "type": "page",
                    "items": [
                        {
                            "type": "container",
                            "orientation": "horizontal",
                            "margins": {
                                "top": "@{safeAreaTop}"
                            },
                            "width": {
                                "type": "fixed",
                                "value": "@{screenWidth > 500 ? 500 : screenWidth}"
                            },
                            "items": [
                                {
                                    "type": "text",
                                    "font_size": 24,
                                    "text_alignment_horizontal": "left",
                                    "alignment_horizontal": "center",
                                    "text_color": "#FFFFFF",
                                    "text": "Вслух",
                                    "width": {
                                        "type": "match_parent"
                                    },
                                    "margins": {
                                        "top": 8,
                                        "bottom": 4,
                                        "left": 16,
                                        "right": 16
                                    },
                                    "_actions": [
                                        {
                                            "log_id": "button_pressed",
                                            "url": "navigate://page?title=&url=#(baseUrl)/app/page/page-test"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "gallery",
                            "orientation": "vertical",
                            "width": {
                                "type": "fixed",
                                "value": "@{screenWidth > 500 ? 500 : screenWidth}"
                            },
                            "height": {
                                "type": "match_parent"
                            },
                            "paddings": {
                                "top": 16,
                                "left": 16,
                                "right": 16
                            },
                            "item_spacing": 16,
                            "items": [
                                {
                                    "type": "title",
                                    "text": "Аудиокниги"
                                },
                                {
                                    "type": "book_block",
                                    "book_author": "Анжей Сапковский",
                                    "book_title": "Ведьмак. Перекресток воронов",
                                    "cover_url": "https://bookreader.hb.ru-msk.vkcloud-storage.ru/audiobooks/witcher/witcher_preview.jpg",
                                    "actions": [
                                        {
                                            "log_id": "button_pressed",
                                            "url": "navigate://page?title=&url=#(baseUrl)/app/books/E740F417-7352-4F8D-9DAF-A51D6AA98994"
                                        }
                                    ]
                                },
                                {
                                    "type": "book_block",
                                    "book_author": "Таня Гуревич",
                                    "book_title": "Цепочка распада",
                                    "cover_url": "https://bookreader.hb.ru-msk.vkcloud-storage.ru/audiobooks/cepochka_raspada/cepochka_raspada_mini.jpg",
                                    "actions": [
                                        {
                                            "log_id": "button_pressed",
                                            "url": "navigate://page?title=&url=#(baseUrl)/app/books/5EA6D77D-95E3-441E-A4C6-C26B10A5C0B6"
                                        }
                                    ]
                                },
                                {
                                    "type": "book_block",
                                    "book_author": "Роберт Шекли",
                                    "book_title": "Кое-что задаром",
                                    "cover_url": "https://bookreader.hb.ru-msk.vkcloud-storage.ru/audiobooks/koe-chto_zadarom/koe-chto_zadarom_mini.jpg",
                                    "actions": [
                                        {
                                            "log_id": "button_pressed",
                                            "url": "navigate://page?title=&url=#(baseUrl)/app/books/63A78E52-F82C-4281-A031-D889E443A697"
                                        }
                                    ]
                                },
                                {
                                    "type": "book_block",
                                    "book_author": "Перейти в раздел",
                                    "book_title": "Другие аудиокниги",
                                    "cover_url": "https://bookreader.hb.ru-msk.vkcloud-storage.ru/images/bookreader_96.png",
                                    "actions": [
                                        {
                                            "log_id": "button_pressed",
                                            "url": "navigate://page?title=&url=#(baseUrl)/app/sections/audiobooks"
                                        }
                                    ]
                                },                                
                                {
                                    "type": "title",
                                    "text": "Спектакли"
                                },
                                {
                                    "type": "book_block",
                                    "book_author": "Эльдар Рязанов",
                                    "book_title": "Гараж",
                                    "cover_url": "https://bookreader.hb.ru-msk.vkcloud-storage.ru/plays/garazh/garazh_preview.jpg",
                                    "actions": [
                                        {
                                            "log_id": "button_pressed",
                                            "url": "navigate://page?title=&url=#(baseUrl)/app/books/3B11DCE7-3E1C-4FED-9212-DCA2A0401B52"
                                        }
                                    ]
                                },
                                {
                                    "type": "book_block",
                                    "book_author": "Эльдар Рязанов",
                                    "book_title": "Любовь и голуби",
                                    "cover_url": "https://bookreader.hb.ru-msk.vkcloud-storage.ru/plays/lyubovigolubi/lyubovigolubi_preview.png",
                                    "actions": [
                                        {
                                            "log_id": "button_pressed",
                                            "url": "navigate://page?title=&url=#(baseUrl)/app/books/CF3207C6-220A-490E-9401-CA3CF757B3D7"
                                        }
                                    ]
                                },
                                {
                                    "type": "title",
                                    "text": "Подкасты"
                                },
                                {
                                    "type": "book_block",
                                    "book_author": "",
                                    "book_title": "Неидеальный подкаст",
                                    "cover_url": "https://bookreader.hb.ru-msk.vkcloud-storage.ru/podcasts/psy/b-three/%D0%B13_preview.png",
                                    "actions": [
                                        {
                                            "log_id": "button_pressed",
                                            "url": "navigate://page?title=&url=#(baseUrl)/app/authors/12BF57E6-B7BF-4648-9A50-8E1F463D8C20"
                                        }
                                    ]
                                },
                                {
                                    "type": "separator"
                                }
                            ]
                        }
                    ]
                }
            }
        ]
    }
}
