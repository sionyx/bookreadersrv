{
    "templates": {
        "page": {
            "type": "container",
            "orientation": "vertical",
            "content_alignment_horizontal": "center",
            "margins": {
                "top": 0,
                "bottom": 0
            },
            "background": [
                {
                    "type": "solid",
                    "color": "#375688",
                    "angle": 270
                }
            ],
            "height": {
                "type": "match_parent"
            }
        },
        "block": {
            "type": "container",
            "orientation": "horizontal",
            "width": {
                "type": "match_parent"
            },
            "height": {
                "type": "wrap_content"
            },
            "background": [
                {
                    "type": "solid",
                    "color": "#4172bc"
                }
            ],
            "border": {
                "corner_radius": 16
            }
            
        },
        "section_block": {
            "type": "block",
            "items": [
                {
                    "type": "image",
                    "width": {
                        "type": "fixed",
                        "value": 48
                    },
                    "aspect": {
                        "ratio": 1
                    },
                    "$image_url": "cover_url",
                    "border": {
                        "corner_radius": 8
                    },
                    "margins": {
                        "top": 16,
                        "bottom": 16,
                        "left": 16
                    }
                },
                {
                    "type": "container",
                    "orientation": "vertical",
                    "alignment_vertical": "center",
                    "items": [
                        {
                            "type": "text",
                            "font_size": 24,
                            "text_alignment_horizontal": "left",
                            "text_color": "#FFFFFF",
                            "$text": "book_title",
                            "width": {
                                "type": "match_parent"
                            },
                            "margins": {
                                "top": 8,
                                "bottom": 4,
                                "left": 8,
                                "right": 16
                            }
                        }
                    ]
                }
            ]
        },
        "book_block": {
            "type": "block",
            "items": [
                {
                    "type": "image",
                    "width": {
                        "type": "fixed",
                        "value": 48
                    },
                    "aspect": {
                        "ratio": 1
                    },
                    "$image_url": "cover_url",
                    "border": {
                        "corner_radius": 8
                    },
                    "margins": {
                        "top": 16,
                        "bottom": 16,
                        "left": 16
                    }
                },
                {
                    "type": "container",
                    "orientation": "vertical",
                    "alignment_vertical": "center",
                    "items": [
                        {
                            "type": "text",
                            "font_size": 24,
                            "text_alignment_horizontal": "left",
                            "text_color": "#FFFFFF",
                            "$text": "book_title",
                            "width": {
                                "type": "match_parent"
                            },
                            "margins": {
                                "top": 8,
                                "bottom": 4,
                                "left": 8,
                                "right": 16
                            }
                        },
                        {
                            "type": "text",
                            "font_size": 12,
                            "text_alignment_horizontal": "left",
                            "text_color": "#a5c6f8",
                            "$text": "book_author",
                            "width": {
                                "type": "match_parent"
                            },
                            "margins": {
                                "bottom": 8,
                                "left": 8,
                                "right": 16
                            }
                        }
                    ]
                }
            ]
        },
        "title": {
            "type": "text",
            "text_color": "#FFFFFF",
            "font_size": 20,
            "line_height": 24,
            "font_weight": "bold",
            "paddings": {
                "left": 24,
                "right": 24,
                "bottom": 16
            }
        },
        "subtitle": {
            "type": "text",
            "text_color": "#a5c6f8",
            "font_size": 15,
            "line_height": 20,
            "paddings": {
                "left": 24,
                "right": 24
            }
        },
        "back_button": {
            "type": "image",
            "scale": "fit",
            "image_url": "https://bookreader.hb.ru-msk.vkcloud-storage.ru/controls/arrow-left-circle-fill.png",
            "aspect": {
                "ratio": 1
            },
            "width": {
                "type": "fixed",
                "value": 48
            }, 
            "paddings": {
                "top": 12,
                "bottom": 12,
                "left": 12,
                "right": 12
            },
            "tint_color": "#ffffff"
        }
    },
    "card": {
        "log_id": "books_card",
        "variables": [
            {
                "name": "default_cover_url",
                "type": "string",
                "value": "https://bookreader.hb.ru-msk.vkcloud-storage.ru/images/bookreader_96.png"
            }
        ],
        "states": [
            {
                "state_id": 0,
                "div": {
                    "type": "page",
                    "items": [
                        {
                            "type": "container",
                            "orientation": "horizontal",
                            "margins": {
                                "top": "@{safeAreaTop}"
                            },
                            "width": {
                                "type": "fixed",
                                "value": "@{screenWidth > 500 ? 500 : screenWidth}"
                            },
                            "items": [
                                {
                                  "type": "back_button",
                                  "alignment_horizontal": "left",
                                  "alignment_vertical": "center",
                                  "margins": {
                                    "left": 8,
                                    "right": 0
                                  },
                                  "actions": [
                                      {
                                          "log_id": "dismiss",
                                          "url": "navigate://dismiss"
                                      }
                                  ]
                                },
                                {
                                    "type": "text",
                                    "font_size": 24,
                                    "text_alignment_horizontal": "left",
                                    "alignment_horizontal": "center",
                                    "text_color": "#FFFFFF",
                                    "text": "#(title)",
                                    "width": {
                                        "type": "match_parent"
                                    },
                                    "margins": {
                                        "top": 8,
                                        "bottom": 4,
                                        "left": 8,
                                        "right": 16
                                    }
                                }
                            ]
                        },
                        {
                            "type": "gallery",
                            "orientation": "vertical",
                            "width": {
                                "type": "fixed",
                                "value": "@{screenWidth > 500 ? 500 : screenWidth}"
                            },
                            "height": {
                                "type": "match_parent"
                            },
                            "paddings": {
                                "top": 16,
                                "left": 16,
                                "right": 16
                            },
                            "item_spacing": 16,
                            "items": [
#for(section in sections):
                                {
                                    "type": "section_block",
                                    "book_author": "",
                                    "book_title": "#(section.title)",
                                    "cover_url": "@{ '#(section.coverUrl)' != '' ? '#(section.coverUrl)' : default_cover_url}",
                                    "actions": [
                                        {
                                            "log_id": "button_pressed",
                                            "url": "navigate://page?title=#(section.title)&url=#(baseUrl)/app/sections/#(section.link_name)"
                                        }
                                    ]
                                },
#endfor
#for(book in books):
                                {
                                    "type": "book_block",
                                    "book_author": "#(book.author)",
                                    "book_title": "#(book.title)",
                                    "cover_url": "@{ '#(book.previewUrl)' != '' ? '#(book.previewUrl)' : default_cover_url}",
                                    "actions": [
                                        {
                                            "log_id": "button_pressed",
                                            "url": "navigate://page?title=#(book.title)&url=#(baseUrl)/app/books/#(book.link_name)"
                                        }
                                    ]
                                },
#endfor
                                {
                                    "type": "separator"
                                }
                            ]
                        }
                    ]
                }
            }
        ]
    }
}
